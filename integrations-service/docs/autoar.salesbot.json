[
  {
    "question": [
      {
        "handler": "widget_request",
        "params": {
          "url": "https://api.atris.site/amocrm/autoar",
          "data": {
            "lead_id": "{{lead.id}}",
            "contact_id": "{{contact.id}}",
            "phone": "{{contact.cf.1844509}}",
            "ar_field_id": "1902731"
          }
        }
      },
      {
        "handler": "goto",
        "params": {
          "type": "question",
          "step": 1
        }
      }
    ]
  },
  {
    "question": [
      {
        "handler": "conditions",
        "params": {
          "logic": "and",
          "conditions": [
            {
              "term1": "{{json.status}}",
              "term2": "success",
              "operation": "="
            }
          ],
          "result": [
            {
              "handler": "action",
              "params": {
                "name": "set_custom_fields",
                "params": {
                  "type": 2,
                  "custom_fields_id": 1902731,
                  "value": "{{json.ar}}"
                }
              }
            },
            {
              "handler": "exits",
              "params": {
                "value": "success"
              }
            }
          ]
        }
      },
      {
        "handler": "exits",
        "params": {
          "value": "fail"
        }
      }
    ]
  }
]
